{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Bash(git merge *)",
      "PowerShell(git merge *)",
      "Bash(git commit --amend*)",
      "PowerShell(git commit --amend*)",
      "Bash(git rebase *)",
      "PowerShell(git rebase *)",
      "Bash(git filter-branch *)",
      "PowerShell(git filter-branch *)",
      "Bash(git push --force*)",
      "PowerShell(git push --force*)",
      "Bash(git push -f*)",
      "PowerShell(git push -f*)",
      "Bash(git reset --hard*)",
      "PowerShell(git reset --hard*)"
    ],
    "defaultMode": "acceptEdits"
  }
}
